{
	"name": "kirby-code-editor",
	"version": "2.0.0",
	"description": "Code editor field for Kirby 6",
	"main": "index.js",
	"author": "Kirby Community",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git@github.com:sylvainjule/kirby-code-editor.git"
	},
	"scripts": {
    	"dev": "kirbyup dev src/index.js",
    	"build": "kirbyup src/index.js",
		"lint": "eslint \"src/**/*.{js,vue}\"",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier --write \"src/**/*.{css,js,vue}\""
	},
	"devDependencies": {
		"consola": "^3.4.2",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-vue": "^9.33.0",
		"prettier": "^3.5.3",
		"prismjs": "^1.30.0",
		"kirbyup": "^4.0.0",
    	"vue-prism-editor": "2.0.0-alpha.2"
	},
	"engines": {
	    "node": ">=24"
	}
}
